   "steps": [
    {
     "fill": "login-email",
     "value": "ada@example.com"
    },
    {
     "fill": "login-password",
     "value": "wrong password"
    },
    {
     "click": "login-submit"
    },
    {
     "wait": "auth-error"
    }
   ],
   "expect": [
    "auth-error"
   ]
  },
  {
   "name": "login-unreachable",
   "route": "/login",
   "login": false,
   "allow_console": [
    "ERR_FAILED",
    "net::"
   ],
   "steps": [
    {
     "route": {
      "url": "**/auth/login",
      "abort": true
     }
    },
    {
     "fill": "login-email",
     "value": "ada@example.com"
    },
    {
     "fill": "login-password",
     "value": "correct horse"
    },
    {
     "click": "login-submit"
    },
    {
     "wait": "auth-error"
    }
   ],
   "expect": [
    "auth-error"
   ]
  },
  {
   "name": "login-submitting",
   "route": "/login",
   "login": false,
   "steps": [
    {
     "route": {
      "url": "**/auth/login",
      "hold": true
